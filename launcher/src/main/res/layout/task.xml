<com.sandboxr.launcher.recents.views.TaskView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_view_single"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:focusable="true">

    <include
        android:id="@+id/snapshot"
        layout="@layout/task_thumbnail" />

    <include
        android:id="@+id/icon"
        layout="@layout/icon_app_chip_view" />

    <include
        android:id="@+id/task_dismiss_button"
        layout="@layout/task_dismiss_button" />

</com.sandboxr.launcher.recents.views.TaskView>
